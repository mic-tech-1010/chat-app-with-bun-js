// use prisma-8

enum CHAT_TYPE{
  DIRECT
  GROUP
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean
  image         String?

  createdAt     TimestamptzString @default(now())
  updatedAt     temporal.updatedAtString()

  sessions      Session[]
  accounts      Account[]
  conversationMemberships ConversationMember[]
  messages Message[]

  @@map("user")
}

model Session {
  id        String    @id
  expiresAt TimestamptzString
  token     String    @unique
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  ipAddress String?
  userAgent String?

  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String

  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  accessToken           String?
  refreshToken          String?
  idToken               String?

  accessTokenExpiresAt  TimestamptzString?
  refreshTokenExpiresAt TimestamptzString?

  scope                 String?
  password              String?

  createdAt             TimestamptzString @default(now())
  updatedAt             temporal.updatedAtString()

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  TimestamptzString

  createdAt  TimestamptzString @default(now())
  updatedAt  temporal.updatedAtString()

  @@index([identifier])
  @@map("verification")
}

model Conversation {
  id Uuid @id @default(uuid())
  type CHAT_TYPE
  name String?
  createdAt  TimestamptzString @default(now())
  updatedAt  temporal.updatedAtString()
  members ConversationMember[]
  messages Message[]
}

model ConversationMember {
  conversationId Uuid
  userId  String
  conversation  Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt TimestamptzString @default(now())

  @@id([conversationId, userId])

  @@index([userId])
}

model Message {
  id Uuid @id @default(uuid())
  content String
  createdAt  TimestamptzString @default(now())
  updatedAt  temporal.updatedAtString()
  conversationId Uuid
  senderId  String?
  conversation  Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender    User?  @relation(fields: [senderId], references: [id], onDelete: SetNull)
  @@index([conversationId, createdAt])
}